{
  "name": "anikode",
  "version": "1.0.0",
  "description": "The AniKode Programming Language compiler and CLI runner.",
  "main": "runner.js",
  "bin": {
    "anikode": "./runner.js"
  },
  "scripts": {
    "test-lexer": "node test_lexer.js",
    "test-parser": "node test_parser.js",
    "test-imports": "node tests/test_imports.js",
    "bundle": "npx esbuild runner.js --bundle --platform=node --outfile=dist/anikode-bundle.js",
    "build": "powershell -ExecutionPolicy Bypass -File build-exe.ps1"
  },
  "keywords": [
    "anikode",
    "compiler",
    "language"
  ],
  "author": "Ayush",
  "license": "ISC",
  "devDependencies": {
    "sharp": "^0.35.3"
  }
}
